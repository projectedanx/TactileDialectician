{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dual-Helix Tool Registry Schema",
  "type": "object",
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool_name": { "type": "string" },
          "description": { "type": "string" },
          "helix_association": {
            "type": "string",
            "enum": ["reflexion", "voyager", "shared"]
          },
          "input_schema": { "type": "object" },
          "c2pa_compliant": { "type": "boolean" }
        },
        "required": ["tool_name", "helix_association", "input_schema"]
      }
    }
  }
}
